  "order_control": {
    "complete_model_requires": [
      "forward/equal_data",
      "forward/equal_wall",
      "reverse/equal_data",
      "reverse/equal_wall"
    ],
    "same_sampling_schedule_required": true,
    "same_seed_set_required": true,
    "same_source_ref_per_model_required": true
  },
  "failure_policy": {
    "allowed_statuses": ["PASS", "FAILED", "EXCLUDED_WITH_EVIDENCE"],
    "promotion_requires_complete_pass_matrix": true,
    "excluded_model_requires_evidence": true,
    "failed_or_excluded_models_are_never_promoted": true
  },
  "output": "model-benchmark-v1/m3_promotion_summary.json"
